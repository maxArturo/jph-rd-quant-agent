# Weekday 04:45 America/New_York trigger for rdq-pred-refresh.service
# (US-048/049).
#
# Slotted after rdq-data-refresh.timer (04:30 ET — advancing the store is
# exactly what stales the promoted pred.pkl) and hours before
# rdq-rebalance.timer (08:00 ET). Moved 06:45 -> 04:45 on 2026-08-07: the
# old slot left 75 minutes for the qrun re-fit, whose early-stop-dependent
# duration overran the budget that morning and delivered predictions five
# minutes after the rebalance's stale-abort. The refresh is now an
# exact-weights re-predict (~10-15 min, deterministic), so this slot is pure
# slack: a failure leaves the operator three hours to intervene before the
# rebalance. Explicit timezone so US DST never drifts the run relative to
# the market session.
#
# Persistent=true: a refresh missed while the box was down is harmless to
# catch up — the run short-circuits when predictions are already fresh, and
# a late refresh lets the operator rerun an aborted rebalance without the
# manual docker procedure.

[Unit]
Description=Weekday 04:45 America/New_York trigger for the promoted-strategy prediction refresh

[Timer]
OnCalendar=Mon..Fri 04:45 America/New_York
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
